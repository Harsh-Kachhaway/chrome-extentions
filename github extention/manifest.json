{
  "manifest_version": 3,
  "name": "GitHub One-Click Download",
  "description": "Add one-click download buttons for files and folders on GitHub.",
  "version": "1.0.0",

  "permissions": [
    "downloads"
  ],

  "host_permissions": [
    "https://github.com/*",
    "https://raw.githubusercontent.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ]
}
